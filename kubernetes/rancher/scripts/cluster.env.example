# 이 파일을 cluster.env로 복사해 실제 값으로 채운다.
#   cp cluster.env.example cluster.env && vi cluster.env
# cluster.env에는 실제 IP·도메인이 들어가므로 git에 올리지 않는다(.gitignore 등록).
# 세 서버 모두 같은 cluster.env를 쓴다. 노드마다 다른 값은 스크립트 인자(1·2·3)로 정해진다.

# 설치할 RKE2 버전. Rancher 2.15.2는 1.36까지 지원한다
RKE2_VERSION='v1.36.4+rke2r1'

# Rancher 도메인. https://와 포트는 넣지 않는다
RANCHER_HOST='rancher.example.com'

# L4 VIP와 MGMT 3대의 IP
VIP_IP='10.0.0.10'
MGMT1_IP='10.0.0.11'
MGMT2_IP='10.0.0.12'
MGMT3_IP='10.0.0.13'

# MGMT-2·3이 조인할 9345 주소. L4가 9345를 넘기면 VIP, 아니면 MGMT-1
JOIN_ADDR="$MGMT1_IP"

# config.yaml 공통 옵션. 세 서버가 같아야 한다
KUBECONFIG_MODE='0600'
ETCD_EXPOSE_METRICS='true'

# PC에서 받아 온 반입 묶음 위치(문서 4.3). 비우면 /home/<sudo 실행 계정>/rke2-artifacts
SRC_DIR=''
# 설치에 쓸 복사 위치
ARTIFACT_DIR='/app/rke2-artifacts'
RKE2_SELINUX_RPM='rke2-selinux-0.23-1.el9.noarch.rpm'

# bind mount 원본 위치(1.6). 이 아래 rancher·kubelet·log-pods를 만든다. 쓰지 않으면 비운다
BIND_BASE='/app/rke2'

# 끌 외부 저장소. 서버에 있는 것만 끈다
DISABLE_REPOS='epel epel-cisco-openh264 rancher-rke2-1.36-stable rancher-rke2-common-stable'

# 사용자 kubeconfig(~/.kube/config)를 만들 노드. MGMT-1이 죽었을 때를 대비해 2번에도 둔다
USER_KUBECONFIG_NODES='1 2'

# 선택: Nexus Docker 저장소 접속 확인 (host:port, HTTP). 비우면 건너뛴다
NEXUS_ADDR=''
